# Template for local-dev env var overrides. Copy to `.env` (gitignored) if
# you want to override the documented defaults; `client/agent/realtime.py`
# does not auto-load `.env` — export these in your shell (or use a tool like
# `direnv`) before running the Client agent.
#
# Note: `connect_and_run` (agent/realtime.py) takes url/token/heartbeat
# interval as plain function parameters and does not read these vars
# itself — they document what a future story's `main.py` wiring (Story
# 2.2+) is expected to read and pass in once it exists.
#
# Same explicit-env-var convention as the repo root's `.env.example`: CI
# sets these explicitly where needed; local dev falls back to the defaults
# below.

# Backend WebSocket endpoint the Client agent connects to (agent/realtime.py,
# Story 2.1). The default below matches the Backend's local dev server.
BACKEND_WS_URL=ws://localhost:8000/ws

# Seconds between heartbeat messages sent over the WebSocket connection
# (agent/realtime.py, Story 2.1). Matches AD-008's "10s (configurable)
# safety tick" wording.
HEARTBEAT_INTERVAL_SECONDS=10

# Bearer token used to authenticate the WebSocket connection (Story 2.1).
# **Temporary stand-in**: Story 2.3 (Zero-Setup Onboarding) will give the
# Client a real identity/auth flow. Until then, hand-copy a token issued by
# `POST /auth/login` (see the repo root CONTRIBUTING.md's Auth walkthrough).
BMAD_AUTH_TOKEN=
