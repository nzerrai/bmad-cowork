# Template for local-dev env var overrides. Copy to `.env.local` (gitignored)
# if you want to override the documented default; Next.js reads `.env*` from
# this app directory (not the repo root), and inlines `NEXT_PUBLIC_*` vars at
# build time.

# Base URL of the Backend API (backend/app/main.py). The default below
# matches the Backend's local dev server (`uv run uvicorn app.main:app --reload`).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base URL of the Backend's WebSocket endpoint (lib/websocket.ts, Story 2.1).
# The default below matches the Backend's local dev server.
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/ws
