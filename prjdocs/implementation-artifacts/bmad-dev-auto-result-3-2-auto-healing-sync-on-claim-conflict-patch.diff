         return self.lease_service.cleanup_expired_leases()
+
+    def signal_sync_required(self, user_id: uuid.UUID, reason: str = "claim_conflict") -> None:
+        """Signal a client to automatically synchronize its state with the Backend/Remote Repo.
+
+        This is triggered when a claim is rejected or a conflict is detected on an active claim.
+        The Backend signals the Client to automatically synchronize its state without manual refresh.
+
+        Args:
+            user_id: The UUID of the user whose client should sync.
+            reason: The reason for the sync signal (e.g., 'claim_conflict', 'claim_rejected').
+        """
+        sync_message = {
+            "type": "sync_required",
+            "reason": reason,
+            "auto_heal": True
+        }
+
+        # Broadcast the sync signal to the user's WebSocket connection(s)
+        # The connection manager will send the message to all connections for this user
+        import asyncio
+        from app.realtime.router import manager as connection_manager
+
+        # Send sync signal via the connection manager's broadcast mechanism
+        # We need to get the user's websocket(s) and send the message
+        for ws in list(connection_manager._connections.get(user_id, set())):
+            try:
+                # Send sync signal to the client
+                asyncio.create_task(ws.send_json(sync_message))
+            except Exception:  # noqa: BLE001 - log but don't fail the sync signal
+                pass
