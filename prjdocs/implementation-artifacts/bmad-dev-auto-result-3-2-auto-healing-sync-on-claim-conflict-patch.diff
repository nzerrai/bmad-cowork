+async def _trigger_auto_healing_sync(connection: websockets.ClientConnection) -> None:
+    """Trigger auto-healing sync to synchronize local state with Backend/Remote Repo.
+
+    This is called when a sync_required signal is received with auto_heal=True.
+    The client automatically synchronizes its state without manual refresh or user intervention.
+    """
+    try:
+        # Request a git state report to synchronize local state with backend
+        # This ensures the local view reflects the corrected state
+        from .git_state import scan_repository
+
+        state = scan_repository(".")
+        sync_report = {
+            "type": "client_git_state_report",
+            "technical_identifier": state.get("technical_identifier"),
+            "branch": state.get("branch"),
+            "ahead": state.get("ahead", 0),
+            "behind": state.get("behind", 0),
+            "in_progress_action": state.get("in_progress_action", "none"),
+            "is_bmad_enabled": state.get("is_bmad_enabled", False),
+        }
+        await connection.send(json.dumps(sync_report))
+        logger.info("Auto-healing sync triggered: sent client_git_state_report")
+    except Exception:  # noqa: BLE001
+        logger.warning("Failed to trigger auto-healing sync")
+
+
