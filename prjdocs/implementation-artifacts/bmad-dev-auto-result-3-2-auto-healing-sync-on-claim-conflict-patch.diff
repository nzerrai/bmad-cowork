             story_id for story_id, lease in self._leases.items()
             if lease.is_active()
         ]
+
+    def detect_claim_conflict(self, story_id: str, claimant_id: uuid.UUID) -> bool:
+        """Detect if there's a conflict on an active claim.
+
+        Returns True if there is a conflict (e.g., lease exists but claimant doesn't match,
+        or lease was rejected/has expired state), False otherwise.
+        """
+        lease = self._leases.get(story_id)
+        if not lease:
+            # No lease exists, no conflict
+            return False
+
+        if not lease.is_active():
+            # Lease is expired, this is a conflict state
+            return True
+
+        # Check if the claimant matches the active lease
+        if str(lease.claimant_id) != str(claimant_id):
+            # Different claimant for active lease - conflict detected
+            return True
+
+        return False
+
+    def is_claim_rejected(self, story_id: str, claimant_id: uuid.UUID) -> bool:
+        """Check if a claim was rejected for a story.
+
+        A claim is considered rejected if:
+        - The story is claimed by a different claimant
+        - The lease has expired or is inactive
+        """
+        lease = self._leases.get(story_id)
+
+        # If no lease exists or lease is inactive, claim was rejected/expired
+        if not lease or not lease.is_active():
+            return True
+
+        # If claimant doesn't match the active lease's claimant, claim was rejected
+        if str(lease.claimant_id) != str(claimant_id):
+            return True
+
+        return False
