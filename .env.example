# Template for local-dev env var overrides. Copy to `.env` (gitignored) if
# you want to override the documented defaults; neither the Backend app nor
# Alembic auto-loads `.env` — export these in your shell (or use a tool like
# `direnv`) before running backend commands.
#
# Both vars follow the same explicit-env-var convention: CI sets them
# explicitly (see .github/workflows/ci.yml); local dev falls back to the
# defaults below, which already match docker-compose.yml.

# PostgreSQL connection string used by both the Backend app (app/db.py) and
# Alembic (alembic.ini / alembic/env.py).
DATABASE_URL=postgresql+psycopg://bmad:bmad@localhost:5433/bmad_portal

# Secret key used to sign/verify JWT bearer tokens (app/config.py). The
# default below is a non-secret dev-only placeholder — never reuse it outside
# local development.
JWT_SECRET_KEY=dev-only-insecure-secret-do-not-use-in-prod
